# Copy only non-secret values into a secret-aware deployment system.
# Never commit the actual DB password, OIDC client secret, PFX password, or private certificate.

ASPNETCORE_ENVIRONMENT=Production
Persistence__Provider=PostgreSql
Authentication__Mode=Oidc
Authentication__Oidc__Authority=https://replace-with-identity-provider.example
Authentication__Oidc__ClientId=replace-with-production-client-id
Authentication__Oidc__NameClaimType=name
Authentication__Oidc__RoleClaimType=role
Authentication__Oidc__MfaClaimType=amr
Authentication__Oidc__MfaClaimValue=mfa
# Allow-list key = verified issuer + verified external claim; never accept a client-supplied tenant UUID.
Tenancy__Organizations__Mvs01__Issuer=https://replace-with-identity-provider.example
Tenancy__Organizations__Mvs01__ExternalOrganizationId=replace-with-verified-organization-id
Tenancy__Organizations__Mvs01__InternalTenantId=7b48e239-07ef-4b34-a1fb-7f4fc7ff1673
Authentication__Oidc__MaxAuthenticationAgeMinutes=15
Audit__QueueCapacity=1024
Audit__WriteTimeoutMilliseconds=250

# Both API instances must see the same protected key ring.
DataProtection__KeyRingPath=/run/toi-no-mori/data-protection-keys
DataProtection__CertificatePath=/run/secrets/data-protection.pfx

# Inject these separately as secrets; they are intentionally absent here:
# ConnectionStrings__PostgreSql          # application role: non-owner / NOINHERIT / no BYPASSRLS
# ConnectionStrings__PostgreSqlMigrator  # migration role: managed-schema DDL owner
# ConnectionStrings__PostgreSqlPlatformAuditWriter  # INSERT-only platform event writer
# ConnectionStrings__PostgreSqlPlatformAuditReader  # SELECT-only PlatformAuditor reader
# Audit__PartitionHashKey                # rotation-managed Base64 secret, 32 bytes or more
# Authentication__Oidc__ClientSecret
# DataProtection__CertificatePassword
