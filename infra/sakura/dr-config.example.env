# Copy values into a secret-aware deployment system. Do not rename this file to .env in production.
# This example intentionally contains no access key, secret key, password, or private-key path.

MVS01_DR_SOURCE_ENDPOINT=https://s3.isk01.sakurastorage.jp
MVS01_DR_SOURCE_REGION=jp-north-1
MVS01_DR_SOURCE_BUCKET=replace-with-ishikari-source-bucket

MVS01_DR_DESTINATION_ENDPOINT=https://s3.tky01.sakurastorage.jp
MVS01_DR_DESTINATION_REGION=jp-east-1
MVS01_DR_DESTINATION_BUCKET=replace-with-tokyo-destination-bucket

MVS01_DR_OBJECT_PREFIX=production/hourly
MVS01_DR_CRR_MAX_WAIT_SECONDS=1800
MVS01_DR_MAX_RPO_SECONDS=3600
MVS01_DR_MAX_RTO_SECONDS=14400
