{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manufacturing-result.schema.json@3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "role",
    "work_order_id",
    "work_order_ref",
    "work_order_hash",
    "base_sha",
    "patch_sha256",
    "scope_changed",
    "tests_requested",
    "known_limits",
    "iteration"
  ],
  "properties": {
    "protocol": {
      "const": "QF-AI-COLLAB-v5"
    },
    "schema_version": {
      "const": "manufacturing-result.schema.json@3"
    },
    "role": {
      "const": "codex_manufacturer"
    },
    "work_order_id": {
      "type": "string",
      "pattern": "^WO-[0-9]{4,}$"
    },
    "work_order_ref": {
      "type": "string",
      "minLength": 1
    },
    "work_order_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests_requested": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "known_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    }
  }
}
