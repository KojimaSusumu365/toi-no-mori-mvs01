{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-order.schema.json@1",
  "title": "QF Work Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "spec",
    "approval"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "source_issue",
        "organizer",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WO-[0-9]{4,}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "source_issue": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "organizer": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "source_question",
        "scope",
        "out_of_scope",
        "acceptance_criteria",
        "required_tests",
        "prohibited_paths",
        "risk_class",
        "evidence_required",
        "stop_conditions",
        "rollback_plan"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "source_question": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibited_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk_class": {
          "enum": [
            "normal",
            "sensitive",
            "governance"
          ]
        },
        "evidence_required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback_plan": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_sha",
        "work_order_hash",
        "expires_at",
        "budget",
        "organizer_decision",
        "execution_state",
        "execution_id",
        "second_human_reviewer",
        "second_human_decision"
      ],
      "properties": {
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "work_order_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_iterations",
            "max_wall_minutes",
            "max_openai_tokens",
            "max_anthropic_tokens",
            "max_actions_minutes"
          ],
          "properties": {
            "max_iterations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "max_wall_minutes": {
              "type": "integer",
              "minimum": 1
            },
            "max_openai_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_anthropic_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_actions_minutes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "organizer_decision": {
          "const": "APPROVED"
        },
        "execution_state": {
          "const": "READY"
        },
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "second_human_reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "second_human_decision": {
          "enum": [
            "NOT_REQUIRED",
            "APPROVED"
          ]
        },
        "second_human_approved_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
