{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding-disposition-record.schema.json@2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "role",
    "decided_by",
    "decided_at",
    "review_artifact_sha256",
    "reviewed_commit_sha",
    "supersedes_record_sha256",
    "decisions"
  ],
  "properties": {
    "protocol": {
      "const": "QF-AI-COLLAB-v5"
    },
    "schema_version": {
      "const": "finding-disposition-record.schema.json@2"
    },
    "role": {
      "const": "organizer"
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewed_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "supersedes_record_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "disposition"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^AUTO-IMPL-P[0-3]-[0-9]{3}$"
          },
          "disposition": {
            "enum": [
              "ACCEPTED_PLAN",
              "REJECTED_WITH_REASON",
              "DEFERRED",
              "POLICY_DECISION_REQUIRED",
              "CLOSED"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "policy_owner": {
            "type": "string"
          },
          "decision_due": {
            "type": "string",
            "format": "date"
          },
          "deferral": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "reason",
              "due"
            ],
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "due": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}
